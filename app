/* ---------------- Exportar ---------------- */
function exportPng(){
  var m = currentMap();
  if (!m){ toast('No hay mapa que exportar'); return; }
  if (!m.nodes.length){ toast('El mapa está vacío'); return; }
  var minX=1e9, minY=1e9, maxX=-1e9, maxY=-1e9;
  m.nodes.forEach(function(n){
    var r = nodeRect(n);
    minX = Math.min(minX, r.x-30); minY = Math.min(minY, r.y-30);
    maxX = Math.max(maxX, r.x+r.w+30); maxY = Math.max(maxY, r.y+r.h+30);
  });
  var bw = maxX-minX, bh = maxY-minY;
  var scale = 2;
  var off = document.createElement('canvas');
  off.width = Math.max(1, Math.round(bw*scale));
  off.height = Math.max(1, Math.round(bh*scale));
  var g = off.getContext('2d');
  var dark = document.documentElement.getAttribute('data-theme') === 'dark';
  g.fillStyle = dark ? '#060910' : '#FFFFFF';
  g.fillRect(0,0,off.width,off.height);
  g.save();
  g.scale(scale, scale);
  g.translate(-minX, -minY);
  renderWorld(g, { ox: 0, oy: 0, zoom: 1, static: true });
  g.restore();
  off.toBlob(function(blob){
    if (blob) download(slug(m.name) + '.png', blob, 'image/png');
    toast('Imagen PNG exportada');
  });
}
function exportJson(){
  var m = currentMap();
  if (!m) return;
  var payload = { app:'vixtory-maps', version:1, exported: new Date().toISOString(), map: m };
  download(slug(m.name) + '.json', JSON.stringify(payload, null, 2), 'application/json');
  toast('Datos JSON exportados');
}
$('fileInput').addEventListener('change', function(){
  var f = this.files[0];
  if (!f) return;
  var reader = new FileReader();
  reader.onload = function(){
    try {
      var data = JSON.parse(reader.result);
      var map = data.map || data;
      if (!map || !Array.isArray(map.nodes)) throw new Error('formato');
      var id = uid();
      var newMap = {
        id: id,
        name: (map.name || 'Mapa importado') + ' (importado)',
        description: map.description || '',
        nodes: map.nodes,
        edges: (map.edges||[]).filter(function(e){ return e && e.from && e.to; }),
        created: Date.now(), updated: Date.now()
      };
      state.maps.push(newMap);
      switchMap(id);
      toast('Mapa importado correctamente');
    } catch(err){
      toast('JSON no válido');
    }
  };
  reader.readAsText(f);
  this.value = '';
});

