/* ---------------- Inicialización ---------------- */
function initTypeFilter(){
  var sel = $('filterType');
  NODE_TYPES.forEach(function(t){
    var o = document.createElement('option');
    o.value = t.id; o.textContent = t.name;
    sel.appendChild(o);
  });
}

function resizeCanvas(){
  var r = canvasWrap.getBoundingClientRect();
  VIEW_W = Math.max(1, r.width);
  VIEW_H = Math.max(1, r.height);
  canvas.width = VIEW_W * DPR;
  canvas.height = VIEW_H * DPR;
  gridCache = null;
  buildGridCache();
  requestRender();
}

window.addEventListener('resize', function(){
  resizeCanvas();
  positionTitleEditor();
});

document.addEventListener('visibilitychange', function(){
  if (document.visibilityState === 'hidden') saveAll();
});

function boot(){
  theme.apply(theme.current());   // aplicar modo claro/oscuro guardado
  refreshThemeColors();
  initTypeFilter();
  loadAll();
  if (!state.maps.length){
    state.maps = demoMaps();
    saveAll();
  }
  if (!state.maps.some(function(m){ return m.id === state.currentId; })){
    state.currentId = state.maps[0].id;
  }
  seedHistory();
  resizeCanvas();
  refreshSidebar();
  syncToolButtons();
  updateZoomLabel();
  renderInspector();
  fitView();
  requestRender();

  // asegurar medidas correctas cuando carguen las fuentes
  if (document.fonts && document.fonts.ready){
    document.fonts.ready.then(function(){ state.dirty = true; requestRender(); });
  }
  // guardar al cerrar
  window.addEventListener('beforeunload', function(){ saveAll(); });
}
boot();
