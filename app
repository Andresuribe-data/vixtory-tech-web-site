function updateNode(id, patch){
  var n = nodeById(id);
  if (!n) return;
  Object.keys(patch).forEach(function(k){ n[k] = patch[k]; });
  n.updated = Date.now();
  pushHistory();
  markChanged(); renderInspector(); requestRender();
}
function updateEdge(id, patch){
  var e = edgeById(id);
  if (!e) return;
  Object.keys(patch).forEach(function(k){ e[k] = patch[k]; });
  pushHistory();
  markChanged(); renderInspector(); requestRender();
}
function countConnections(id){
  var m = currentMap(); if (!m) return 0;
  var c = 0;
  m.edges.forEach(function(e){ if (e.from===id || e.to===id) c++; });
  return c;
}

