$('mapList').addEventListener('click', function(e){
  var card = e.target.closest('.map-card');
  if (!card) return;
  var id = card.getAttribute('data-id');
  var act = e.target.closest('[data-act]');
  if (act){
    var action = act.getAttribute('data-act');
    if (action === 'rename'){ renameMapInline(card, id); }
    if (action === 'dup'){ duplicateMap(id); }
    if (action === 'export'){ exportMapJson(id); }
    if (action === 'del'){ deleteMap(id); }
    return;
  }
  if (id !== state.currentId) switchMap(id);
});
function renameMapInline(card, id){
  var nameEl = card.querySelector('.m-name span');
  var inp = document.createElement('input');
  inp.type = 'text';
  inp.value = nameEl.textContent;
  nameEl.replaceWith(inp);
  inp.focus(); inp.select();
  inp.addEventListener('blur', function(){ commitRename(id, inp.value); });
  inp.addEventListener('keydown', function(e){
    if (e.key === 'Enter'){ inp.blur(); }
    if (e.key === 'Escape'){ commitRename(id, null); }
  });
}
function commitRename(id, val){
  var map = state.maps.find(function(x){ return x.id === id; });
  if (map && val) map.name = val.trim() || map.name;
  if (map) map.updated = Date.now();
  saveAll(); refreshSidebar();
}
function duplicateMap(id){
  var src = state.maps.find(function(x){ return x.id === id; });
  if (!src) return;
  var copy = deepCopy(src);
  copy.id = uid();
  copy.name = src.name + ' (copia)';
  copy.nodes.forEach(function(n){ n.id = uid(); });
  var idMap = {};
  src.nodes.forEach(function(n, i){ idMap[n.id] = copy.nodes[i].id; });
  copy.edges.forEach(function(e){ e.id = uid(); e.from = idMap[e.from] || e.from; e.to = idMap[e.to] || e.to; });
  copy.created = Date.now(); copy.updated = Date.now();
  state.maps.push(copy);
  saveAll(); refreshSidebar();
  toast('Mapa duplicado');
}
function deleteMap(id){
  if (state.maps.length <= 1){ toast('Debe quedar al menos un mapa'); return; }
  if (!confirm('¿Eliminar este mapa? Esta acción no se puede deshacer.')) return;
  state.maps = state.maps.filter(function(x){ return x.id !== id; });
  if (state.currentId === id) state.currentId = state.maps[0].id;
  saveAll(); refreshSidebar(); renderInspector(); requestRender();
  toast('Mapa eliminado');
}
function exportMapJson(id){
  var map = state.maps.find(function(x){ return x.id === id; });
  if (!map) return;
  download(slug(map.name) + '.json', JSON.stringify({ app:'vixtory-maps', version:1, map: map }, null, 2), 'application/json');
}
function switchMap(id){
  state.currentId = id;
  state.selection.nodes = []; state.selection.edges = [];
  seedHistory();
  state.linkDrag = null; state.marquee = null;
  state.filter.text = ''; state.filter.type = ''; state.filter.imp = '';
  $('filterSearch').value = ''; $('filterType').value = ''; $('filterImp').value = '';
  saveAll();
  refreshSidebar(); renderInspector();
  fitView();
  requestRender();
  toast('Mapa: ' + currentMap().name);
}
