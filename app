    g.save();
    g.translate(sx, sy);
    g.scale(z, z);   // escalar el nodo con el zoom (mundo → pantalla)
    g.globalAlpha = dim ? 0.22 : 1;

    var fill = n.color || t.color;
    var imp = IMPORTANCE[n.importance] || IMPORTANCE.media;
    var prio = (n.priority && PRIORITIES[n.priority]) ? PRIORITIES[n.priority] : null;

    // sombra (unidades de mundo; el contexto ya está escalado por z)
    g.shadowColor = 'rgba(14,24,48,.16)';
    g.shadowBlur = 8;
    g.shadowOffsetY = 2;

    // cuerpo
    shapePath(g, 0, 0, msz.w, msz.h, t.shape);
    if (n.type === 'central'){
      var grad = g.createLinearGradient(-hw, -hh, hw, hh);
      grad.addColorStop(0, fill); grad.addColorStop(1, shade(fill, -22));
      g.fillStyle = grad;
    } else {
      g.fillStyle = TCOL.nodeFill;
      g.fill();
      g.fillStyle = fill;
      g.globalAlpha = dim ? 0.22 : 0.06;
      g.fill();
      g.globalAlpha = dim ? 0.22 : 1;
    }
    g.shadowColor = 'transparent';
    // borde: el color de la prioridad pinta TODO el contorno (grosor mínimo visible en pantalla)
    g.lineWidth = Math.max(0.8/z, n.type === 'central' ? 2 : 1.6);
    g.strokeStyle = prio ? prio.color : fill;
    if (isSel){ g.strokeStyle = TCOL.selRing; g.lineWidth = Math.max(1/z, 2.4); }
    if (isHover && !isSel){ g.lineWidth = Math.max(0.9/z, 2); }
    shapePath(g, 0, 0, msz.w, msz.h, t.shape);
    g.stroke();

    // barra de importancia (izquierda)
    g.fillStyle = imp.color;
    g.fillRect(-hw, -hh+6, 5, msz.h-12);

    // contenido: icono arriba-izquierda, nombre a su derecha, descripción en todo el espacio inferior
    var sc = n.scale || 1;
    var padX = Math.round(10 * sc);
    var padTop = Math.round(8 * sc);
    var iconSize = Math.round(17 * sc);
    var textX = -hw + padX;
    var topY = -hh + padTop;

    // icono (arriba-izquierda)
    if (n.type !== 'central'){
      g.font = iconSize + 'px Inter, sans-serif';
      g.textAlign = 'center'; g.textBaseline = 'middle';
      g.fillText(t.icon, textX + iconSize/2, topY + iconSize/2);
      g.textAlign = 'left'; g.textBaseline = 'alphabetic';
    }
    // nombre (a la derecha del icono)
    var nameX = textX + (n.type === 'central' ? 0 : iconSize + 6*sc);
    var nameMaxW = Math.max(40, msz.w - padX*2 - (n.type === 'central' ? 0 : iconSize + 6*sc));
    g.font = '600 ' + Math.round((n.type === 'central' ? 16 : 14) * sc) + 'px Inter, "Segoe UI", sans-serif';
    g.fillStyle = n.type === 'central' ? '#FFFFFF' : TCOL.ink;
    var nameLines = wrapLines(n.title || (n.type==='central' ? 'Tema' : 'Nodo'), nameMaxW).slice(0,2);
    var nameY = topY + Math.round(13 * sc);
    nameLines.forEach(function(l){
      g.fillText(l, nameX, nameY);
      nameY += Math.round(17 * sc);
    });
    // descripción: todo el espacio inferior, truncada con "…"
    var desc = (n.description || '').trim();
    if (desc){
      g.font = '400 ' + Math.round(11*sc) + 'px Inter, sans-serif';
      g.fillStyle = TCOL.soft;
      var descW = Math.max(40, msz.w - padX*2);
      var dl = wrapLinesEllipsis(desc, descW, 4);
      var headerH = Math.max(iconSize, nameLines.length * Math.round(17*sc));
      var dy = topY + headerH + 4*sc;
      dl.forEach(function(l){
        g.fillText(l, textX, dy + Math.round(10*sc));
        dy += Math.round(14*sc);
      });
    }
    // badge de prioridad (arriba a la derecha)
    if (n.priority && PRIORITIES[n.priority] && n.type !== 'central'){
      var p = PRIORITIES[n.priority];
      g.font = '700 9.5px "IBM Plex Mono", monospace';
      var pw = 20;
      g.fillStyle = p.color;
      roundRect(g, hw - pw - 6, -hh + 4, pw, 14, 7); g.fill();
      g.fillStyle = '#fff';
      g.textAlign = 'center'; g.textBaseline = 'middle';
      g.fillText(p.label, hw - pw/2 - 6, -hh + 11);
      g.textAlign = 'left'; g.textBaseline = 'alphabetic';
    }
    g.restore();

    // puertos (hover o selección) — en coordenadas de pantalla
    if ((isHover || isSel) && !opts.static){
      var pr = 4.5;
      var ports = [ ['n', 0, -hh*z], ['s', 0, hh*z], ['e', hw*z, 0], ['w', -hw*z, 0] ];
      ports.forEach(function(p){
        var px = sx + p[1], py = sy + p[2];
        g.beginPath(); g.arc(px, py, pr, 0, Math.PI*2);
        g.fillStyle = TCOL.nodeFill; g.fill();
        g.lineWidth = 2; g.strokeStyle = TCOL.port; g.stroke();
      });
      // asa de redimensionado (esquina inferior derecha, solo 1 nodo seleccionado)
      if (isSel && state.selection.nodes.length === 1){
        var hz2 = 8;
        g.strokeStyle = TCOL.port;
        g.lineWidth = 2;
        g.beginPath();
        g.moveTo(sx + hw*z - hz2, sy + hh*z); g.lineTo(sx + hw*z, sy + hh*z); g.lineTo(sx + hw*z, sy + hh*z - hz2);
        g.stroke();
        g.fillStyle = TCOL.port;
        g.beginPath(); g.arc(sx + hw*z, sy + hh*z, 3.2, 0, Math.PI*2); g.fill();
      }
    }
  });

  // ---- marquee ----
  if (state.marquee && !opts.static){
    g.fillStyle = TCOL.marquee;
    g.strokeStyle = TCOL.edgeSel;
    g.lineWidth = 1;
    g.beginPath();
    g.rect(state.marquee.x, state.marquee.y, state.marquee.w, state.marquee.h);
    g.fill(); g.stroke();
  }
  // ---- preview de conexión ----
  if (state.linkDrag && !opts.static){
    var a = nodeById(state.linkDrag.from);
    if (a){
      var curWx = sx2wx(state.linkDrag.cx);
      var sp = anchorPoint(a, curWx >= a.x ? 0 : Math.PI);
      g.strokeStyle = TCOL.port;
      g.lineWidth = Math.max(0.6, 2*z);
      g.setLineDash([6*z, 5*z]);
      g.beginPath();
      g.moveTo(gx(sp.x), gy(sp.y));
      g.lineTo(state.linkDrag.cx, gy(sp.y));
      g.lineTo(state.linkDrag.cx, state.linkDrag.cy);
      g.stroke();
      g.setLineDash([]);
      g.beginPath(); g.arc(state.linkDrag.cx, state.linkDrag.cy, 5, 0, Math.PI*2);
      g.fillStyle = TCOL.port; g.fill();
    }
  }
}
function roundRect(g, x, y, w, h, r){
  g.beginPath();
  g.moveTo(x+r, y);
  g.arcTo(x+w, y, x+w, y+h, r);
  g.arcTo(x+w, y+h, x, y+h, r);
  g.arcTo(x, y+h, x, y, r);
  g.arcTo(x, y, x+r, y, r);
  g.closePath();
}
function shade(hex, amt){
  var c = hex.replace('#','');
  if (c.length === 3) c = c.split('').map(function(x){ return x+x; }).join('');
  var r = clamp(parseInt(c.substr(0,2),16) + amt, 0, 255);
  var g = clamp(parseInt(c.substr(2,2),16) + amt, 0, 255);
  var b = clamp(parseInt(c.substr(4,2),16) + amt, 0, 255);
  return 'rgb(' + r + ',' + g + ',' + b + ')';
}

/* ---------------- Bucle de render ---------------- */
var rafPending = false;
function requestRender(){ state.dirty = true; if (!rafPending){ rafPending = true; requestAnimationFrame(renderLoop); } }
function renderLoop(){
  rafPending = false;
  if (!state.dirty) return;
  state.dirty = false;
  var m = currentMap();
  var dark = document.documentElement.getAttribute('data-theme') === 'dark';
  var bg = dark ? '#060910' : '#FBFBFE';
  if (!gridCache || gridCache.width !== VIEW_W || gridCache.height !== VIEW_H){
    buildGridCache();
  }
  ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  if (state.grid){
    ctx.drawImage(gridCache, 0, 0);
  } else {
    ctx.fillStyle = bg; ctx.fillRect(0,0,VIEW_W,VIEW_H);
  }
  renderWorld(ctx, {});
  // estado vacío
  var es = $('emptyState');
  if (es) es.style.display = (m && m.nodes.length === 0) ? 'flex' : 'none';
}

/* ---------------- Acciones de nodos ---------------- */
function createNode(type, wx, wy, opts){
  opts = opts || {};
  var m = currentMap();
  if (!m) return null;
  var t = type || state.tool.type;
  var n = {
    id: uid(),
    type: t,
    title: opts.title || typeById(t).name,
    description: opts.description || '',
    tags: opts.tags || [],
    importance: opts.importance || state.tool.importance,
    priority: (opts.priority !== undefined) ? opts.priority : state.tool.priority,
    color: (opts.color !== undefined) ? opts.color : state.tool.color,
    scale: (opts.scale !== undefined) ? opts.scale : 1,
    x: wx, y: wy,
    created: Date.now(), updated: Date.now()
  };
  m.nodes.push(n);
  return n;
}
function deleteSelection(){
  var m = currentMap();
  if (!m) return;
  var nodeSel = state.selection.nodes.slice();
  var edgeSel = state.selection.edges.slice();
  if (!nodeSel.length && !edgeSel.length) return;
  var set = {};
  nodeSel.forEach(function(id){ set[id] = 1; });
  m.nodes = m.nodes.filter(function(n){ return !set[n.id]; });
  var edgeSet = {};
  edgeSel.forEach(function(id){ edgeSet[id] = 1; });
  // eliminar aristas conectadas a nodos borrados
  m.edges = m.edges.filter(function(e){
    if (edgeSet[e.id]) return false;
    if (set[e.from] || set[e.to]) return false;
    return true;
  });
  pushHistory();
  state.selection.nodes = [];
  state.selection.edges = [];
  markChanged(); renderInspector(); requestRender();
  toast(nodeSel.length + (nodeSel.length===1?' nodo eliminado':' nodos eliminados'));
}
function duplicateSelection(){
  var m = currentMap();
  if (!m) return;
  if (!state.selection.nodes.length){ toast('Selecciona nodos para duplicar'); return; }
  var newSel = [];
  state.selection.nodes.forEach(function(id){
    var n = nodeById(id);
    if (!n) return;
    var c = deepCopy(n);
    c.id = uid(); c.x += 30; c.y += 30; c.created = Date.now(); c.updated = Date.now();
    m.nodes.push(c);
    newSel.push(c.id);
  });
  pushHistory();
  state.selection.nodes = newSel;
  state.selection.edges = [];
  markChanged(); renderInspector(); requestRender();
}
function addEdge(from, to){
  var m = currentMap();
  if (!m || from === to) return null;
  var dup = m.edges.some(function(e){ return e.from===from && e.to===to; });
  if (dup) return null;
  var e = { id: uid(), from: from, to: to, label: '', style: 'solid', color: null };
  m.edges.push(e);
  pushHistory();
  markChanged(); renderInspector(); requestRender();
  return e.id;
}

