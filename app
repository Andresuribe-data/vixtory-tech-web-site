  if (!m){ body.innerHTML = ''; return; }
  var nodes = state.selection.nodes;
  var edges = state.selection.edges;

  if (nodes.length === 1 && edges.length === 0){
    renderNodeInspector(nodeById(nodes[0]));
  } else if (nodes.length > 1 && edges.length === 0){
    renderMultiInspector();
  } else if (nodes.length === 0 && edges.length === 1){
    renderEdgeInspector(edgeById(edges[0]));
  } else {
