<script>
'use strict';
/* =====================================================================
   VIXTORY MAPS — Editor de mapas mentales
   Canvas infinito · nodos por tipo · importancia · prioridades ·
   etiquetas · descripciones · conexiones · múltiples mapas · modo oscuro
   ===================================================================== */

/* ---------------- Utilidades ---------------- */
var $ = function(id){ return document.getElementById(id); };
function uid(){ return 'n' + Date.now().toString(36) + Math.random().toString(36).slice(2,7); }
function clamp(v, a, b){ return Math.max(a, Math.min(b, v)); }
function debounce(fn, ms){ var t; return function(){ clearTimeout(t); t = setTimeout(fn, ms); }; }
function esc(s){ return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
function slug(s){ return String(s).toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'') || 'mapa'; }
function download(filename, data, mime){
  var blob = data instanceof Blob ? data : new Blob([data], { type: mime || 'application/octet-stream' });
  var url = URL.createObjectURL(blob);
  var a = document.createElement('a');
  a.href = url; a.download = filename;
  document.body.appendChild(a); a.click();
  setTimeout(function(){ document.body.removeChild(a); URL.revokeObjectURL(url); }, 120);
}
function toast(msg){
  var t = $('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(t._h);
  t._h = setTimeout(function(){ t.classList.remove('show'); }, 2200);
}
function deepCopy(o){ return JSON.parse(JSON.stringify(o)); }
function parseTags(str){
  return String(str||'').split(',').map(function(s){ return s.trim(); }).filter(Boolean).slice(0,8);
}

/* ---------------- Tema claro / oscuro ---------------- */
var THEME_KEY = 'vixtory.theme';
var theme = (function(){
  var root = document.documentElement;
  function current(){
    try { return localStorage.getItem(THEME_KEY) || 'light'; } catch(e){ return 'light'; }
  }
  function apply(mode){
    root.setAttribute('data-theme', mode);
    var sw = $('themeSwitch');
    if (sw) sw.classList.toggle('on', mode === 'dark');
    try { localStorage.setItem(THEME_KEY, mode); } catch(e){}
    refreshThemeColors();
    requestRender();
  }
  return { current: current, apply: apply };
})();
$('themeSwitch').addEventListener('click', function(){
  theme.apply(document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
});

/* ---------------- Configuración de nodos ---------------- */
var NODE_TYPES = [
  { id:'central',    name:'Central',    icon:'✦', color:'#4F6FEF', shape:'circle',       blurb:'Tema raíz del mapa. Una visión.' },
  { id:'idea',       name:'Idea',       icon:'💡', color:'#8B5CF6', shape:'rounded',      blurb:'Pensamiento o concepto.' },
  { id:'task',       name:'Tarea',      icon:'☑',  color:'#22C55E', shape:'rounded',      blurb:'Acción ejecutable.' },
  { id:'decision',   name:'Decisión',   icon:'⚖',  color:'#4F6FEF', shape:'hexagon',      blurb:'Punto de elección.' },
  { id:'question',   name:'Pregunta',   icon:'?',  color:'#F59E0B', shape:'diamond',      blurb:'Duda abierta por resolver.' },
  { id:'problem',    name:'Problema',   icon:'!',  color:'#EF4444', shape:'octagon',      blurb:'Obstáculo o reto.' },
  { id:'argument',   name:'Argumento',  icon:'»',  color:'#06B6D4', shape:'parallelogram',blurb:'Razón a favor o en contra (IBIS).' },
  { id:'resource',   name:'Recurso',    icon:'🔗', color:'#14B8A6', shape:'rounded',      blurb:'Enlace, documento o herramienta.' },
  { id:'note',       name:'Nota',       icon:'✎',  color:'#A855F7', shape:'square',       blurb:'Anotación libre.' },
  { id:'milestone',  name:'Hito',       icon:'🏁', color:'#F97316', shape:'pentagon',     blurb:'Logro o fecha clave.' },
  { id:'risk',       name:'Riesgo',     icon:'⚡', color:'#F43F5E', shape:'triangle',     blurb:'Amenaza potencial.' },
  { id:'person',     name:'Persona',    icon:'👤', color:'#0EA5E9', shape:'rounded',      blurb:'Stakeholder o responsable.' },
  { id:'metric',     name:'Métrica',    icon:'📊', color:'#84CC16', shape:'bar',          blurb:'Indicador o KPI.' }
];
var typeById = function(id){ for (var i=0;i<NODE_TYPES.length;i++) if (NODE_TYPES[i].id===id) return NODE_TYPES[i]; return NODE_TYPES[1]; };

var IMPORTANCE = {
  alta:  { label:'Alta',  color:'#EF4444' },
  media: { label:'Media', color:'#F59E0B' },
  baja:  { label:'Baja',  color:'#3B82F6' }
};
var PRIORITIES = {
  p0:{ label:'P0', color:'#EF4444' },
  p1:{ label:'P1', color:'#F97316' },
  p2:{ label:'P2', color:'#4F6FEF' },
  p3:{ label:'P3', color:'#94A3B8' }
};
var PALETTE = ['#4F6FEF','#8B5CF6','#00E5FF','#3ECF8E','#22C55E','#84CC16','#F59E0B','#F97316','#EF4444','#F43F5E','#14B8A6','#0EA5E9','#A855F7','#64748B'];

/* ---------------- Estado ---------------- */
var STORE_KEY = 'vixtory.maps.v1';
var CURRENT_KEY = 'vixtory.current.v1';
var SETTINGS_KEY = 'vixtory.settings.v1';

var state = {
  maps: [],            // [{id,name,description,nodes:[],edges:[],created,updated}]
  currentId: null,
  view: { x: -400, y: -300, zoom: 1 },
  selection: { nodes: [], edges: [] },     // arrays de ids
  hoverNode: null, hoverEdge: null, hoverPort: null,
  tool: { type:'idea', importance:'media', priority:null, color:null },
  hand: false, connectMode: false,
  grid: true,
  filter: { text:'', type:'', imp:'' },
  editing: null,       // {id, field}
  pointer: null,       // estado activo del puntero
  lastP: { x: 0, y: 0 },
  marquee: null,
  linkDrag: null,
  moveDrag: null,
  dirty: true, animT: 0,
  history: [], historyIdx: -1, historyLock: false,
  saveState: 'saved'
};

function currentMap(){ 
  for (var i=0;i<state.maps.length;i++) if (state.maps[i].id===state.currentId) return state.maps[i];
  return state.maps[0] || null;
}
function nodeById(id){ var m = currentMap(); if (!m) return null; for (var i=0;i<m.nodes.length;i++) if (m.nodes[i].id===id) return m.nodes[i]; return null; }
function edgeById(id){ var m = currentMap(); if (!m) return null; for (var i=0;i<m.edges.length;i++) if (m.edges[i].id===id) return m.edges[i]; return null; }

/* ---------------- Almacenamiento ---------------- */
function saveAll(){
  try {
    localStorage.setItem(STORE_KEY, JSON.stringify(state.maps));
    localStorage.setItem(CURRENT_KEY, state.currentId || '');
    localStorage.setItem(SETTINGS_KEY, JSON.stringify({ hand:state.hand, connect:state.connectMode, grid:state.grid, tool:state.tool }));
  } catch(e){ console.warn('No se pudo guardar:', e); }
}
var scheduleSave = debounce(function(){
  saveAll();
  state.saveState = 'saved';
  $('saveState').textContent = 'Guardado';
  $('saveState').classList.remove('saving');
}, 450);
function markChanged(){
  var m = currentMap();
  if (m) m.updated = Date.now();
  state.dirty = true;
  state.saveState = 'saving';
  var el = $('saveState');
  el.textContent = 'Guardando…';
  el.classList.add('saving');
  scheduleSave();
  refreshSidebar();
}
function loadAll(){
  try {
