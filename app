<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" type="image/png" href="data:image/png;base64,">
<link rel="apple-touch-icon" href="data:image/png;base64,">
<title>Vixtory Maps — Editor de mapas mentales</title>
<meta name="description" content="Vixtory Maps: crea, mueve y conecta nodos libremente. Tipos de nodos, prioridades, etiquetas, descripciones, varios mapas y modo oscuro. Por Vixtory Tech.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  /* ============ Tokens Vixtory Tech ============ */
  :root{
    --bg:#F7F8FC; --bg-alt:#EEF0FA; --surface:#FFFFFF;
    --ink:#0E1830; --ink-soft:#4B5573; --ink-faint:#8890AA; --line:#E1E4F0;
    --blue:#4F6FEF; --violet:#8B5CF6; --cyan:#00E5FF; --green:#3ECF8E; --red:#EF4444; --amber:#F59E0B;
    --grad:linear-gradient(135deg,#4F6FEF 0%,#8B5CF6 100%);
    --shadow:0 1px 2px rgba(14,24,48,.05),0 10px 28px -14px rgba(14,24,48,.18);
    --ease:cubic-bezier(.16,.84,.44,1);
    --canvas-bg:#FBFBFE; --grid-line:rgba(14,24,48,.06); --grid-major:rgba(14,24,48,.11);
  }
  html[data-theme="dark"]{
    --bg:#05070D; --bg-alt:#080C16; --surface:#0D1220;
    --ink:#F4F6FC; --ink-soft:#8E99B2; --ink-faint:#56617A; --line:rgba(255,255,255,.10);
    --blue:#5B7CFF; --violet:#9A6CFF; --cyan:#00E5FF; --green:#58F0BA; --red:#F87171; --amber:#FBBF24;
    --shadow:0 1px 2px rgba(0,0,0,.5),0 12px 30px -14px rgba(0,0,0,.7);
    --canvas-bg:#060910; --grid-line:rgba(255,255,255,.05); --grid-major:rgba(255,255,255,.10);
  }
  *{ box-sizing:border-box; margin:0; padding:0; }
  html,body{ height:100%; overflow:hidden; }
  body{
    background:var(--bg); color:var(--ink);
    font-family:'Inter', system-ui, sans-serif; font-size:14px;
    -webkit-font-smoothing:antialiased;
    transition: background .3s var(--ease), color .3s var(--ease);
  }
  button{ font-family:inherit; }
  input, select, textarea{
    font-family:inherit; color:var(--ink); background:var(--surface);
    border:1px solid var(--line); border-radius:9px; padding:8px 10px; font-size:13px;
    outline:none; transition:border-color .2s, box-shadow .2s;
  }
  input:focus, select:focus, textarea:focus{ border-color:var(--blue); box-shadow:0 0 0 3px rgba(79,111,239,.15); }
  ::-webkit-scrollbar{ width:10px; height:10px; }
  ::-webkit-scrollbar-thumb{ background:var(--line); border-radius:8px; border:2px solid transparent; background-clip:content-box; }
  ::-webkit-scrollbar-thumb:hover{ background:var(--ink-faint); background-clip:content-box; }

  .app{ display:flex; flex-direction:column; height:100vh; }

  /* ============ TOP BAR ============ */
  .topbar{
    display:flex; align-items:center; gap:14px;
    padding:8px 16px; background:var(--surface);
    border-bottom:1px solid var(--line); flex-shrink:0;
  }
  .brand{ display:flex; align-items:center; gap:9px; text-decoration:none; color:var(--ink); }
  .brand-mark{
    width:30px; height:30px; border-radius:9px; display:grid; place-items:center;
    background:var(--grad); box-shadow:0 3px 12px -3px rgba(91,124,255,.5); flex-shrink:0;
  }
  .brand-mark svg{ width:17px; height:17px; }
  .brand-logo{ height:32px; width:auto; }
  html[data-theme='dark'] .brand-logo{ filter: brightness(0) invert(1); }
  .brand-name{ font-family:'Space Grotesk'; font-weight:600; font-size:14.5px; }
  .brand-name span{ color:var(--ink-faint); font-weight:500; }
  .v-div{ width:1px; height:26px; background:var(--line); flex-shrink:0; }

  .map-name-wrap{ display:flex; align-items:center; gap:8px; min-width:0; }
  .map-name-label{ font-family:'IBM Plex Mono',monospace; font-size:10px; letter-spacing:.12em; text-transform:uppercase; color:var(--ink-faint); }
  #mapName{
    font-family:'Space Grotesk'; font-weight:600; font-size:15px;
    border:none; background:transparent; padding:6px 8px; border-radius:8px; cursor:text;
    min-width:120px; max-width:280px; border:1px solid transparent;
  }
  #mapName:hover{ background:var(--bg-alt); }
  #mapName:focus{ border-color:var(--blue); background:var(--surface); }

  .toolbar{ display:flex; align-items:center; gap:6px; margin-left:auto; flex-wrap:nowrap; overflow:visible; }
  .tbtn{
    display:inline-flex; align-items:center; gap:6px;
    height:34px; padding:0 11px; border-radius:9px;
    background:var(--surface); border:1px solid var(--line); color:var(--ink-soft);
    font-size:12.5px; font-weight:600; cursor:pointer; white-space:nowrap;
    transition: color .18s var(--ease), border-color .18s var(--ease), background .18s var(--ease), box-shadow .18s var(--ease);
    position:relative;
  }
  .tbtn:hover{ color:var(--ink); border-color:var(--ink-faint); }
  .tbtn.active{ background:color-mix(in srgb,var(--blue) 12%,var(--surface)); border-color:var(--blue); color:var(--blue); }
  .tbtn.primary{ background:var(--grad); color:#fff; border-color:transparent; }
  .tbtn.primary:hover{ box-shadow:0 6px 18px -6px rgba(79,111,239,.6); }
  .tbtn svg{ width:15px; height:15px; flex-shrink:0; }
  .tbtn .type-ic{ font-size:14px; line-height:1; }
  .hide-desktop{ display:none; }
  .sep{ width:1px; height:24px; background:var(--line); margin:0 3px; flex-shrink:0; }

  .pop{
    position:absolute; top:calc(100% + 8px); right:0; z-index:60;
    background:var(--surface); border:1px solid var(--line); border-radius:14px;
    box-shadow:var(--shadow); padding:12px; min-width:210px;
    display:none; animation: popIn .12s var(--ease);
  }
  @keyframes popIn{ from{ opacity:0; transform:translateY(-6px) scale(.98);} to{ opacity:1; transform:none;} }
  .pop.open{ display:block; }
  .pop h5{ font-family:'IBM Plex Mono',monospace; font-size:10px; letter-spacing:.12em; text-transform:uppercase; color:var(--ink-faint); margin:4px 0 8px; }
  .type-grid{ display:grid; grid-template-columns:1fr 1fr; gap:6px; }
  .type-opt{
    display:flex; align-items:center; gap:8px; padding:7px 9px; border-radius:9px;
    cursor:pointer; font-size:12.5px; font-weight:500; color:var(--ink-soft);
    border:1px solid transparent; transition:all .15s;
  }
  .type-opt:hover{ background:var(--bg-alt); color:var(--ink); }
  .type-opt.sel{ background:color-mix(in srgb,var(--blue) 10%,var(--surface)); border-color:var(--blue); color:var(--ink); }
  .type-opt .dot{ width:14px; height:14px; border-radius:4px; flex-shrink:0; display:grid; place-items:center; font-size:9px; color:#fff; }

  .imp-row{ display:flex; gap:6px; }
  .imp-opt{
    flex:1; display:flex; flex-direction:column; align-items:center; gap:4px;
    padding:8px 6px; border-radius:9px; border:1px solid var(--line); cursor:pointer; font-size:10.5px; font-weight:600; color:var(--ink-soft); transition:all .15s;
  }
  .imp-opt .bar{ height:4px; width:22px; border-radius:3px; }
  .imp-opt.sel{ border-color:var(--blue); background:color-mix(in srgb,var(--blue) 8%,var(--surface)); color:var(--ink); }

  .pri-row{ display:flex; gap:6px; }
  .pri-opt{
    width:38px; height:30px; border-radius:8px; border:1px solid var(--line);
    display:grid; place-items:center; font-family:'IBM Plex Mono',monospace; font-size:11px; font-weight:700;
    cursor:pointer; color:var(--ink-soft); transition:all .15s;
  }
  .pri-opt.sel{ color:#fff; transform:translateY(-1px); box-shadow:0 4px 10px -4px rgba(0,0,0,.35); }
  .pri-opt.none{ font-size:10px; }

  .color-grid{ display:grid; grid-template-columns:repeat(8,1fr); gap:7px; }
  .color-swatch{
    width:24px; height:24px; border-radius:7px; cursor:pointer;
    border:2px solid transparent; transition:transform .15s;
  }
  .color-swatch:hover{ transform:scale(1.15); }
  .color-swatch.sel{ border-color:var(--ink); }
  .color-swatch.reset{
    background:conic-gradient(#EF4444,#F59E0B,#84CC16,#06B6D4,#4F6FEF,#8B5CF6,#EF4444);
    position:relative;
  }
  .color-swatch.reset::after{ content:'✕'; position:absolute; inset:0; display:grid; place-items:center; font-size:11px; color:#fff; font-weight:700; }
  .color-custom{ width:100%; margin-top:9px; display:flex; gap:8px; align-items:center; }
  .color-custom input[type=color]{ width:34px; height:30px; padding:2px; border-radius:8px; border:1px solid var(--line); background:var(--surface); cursor:pointer; }
  .color-custom input[type=text]{ flex:1; font-family:'IBM Plex Mono',monospace; font-size:11px; }

  /* ============ LAYOUT ============ */
  .main{ display:flex; flex:1; min-height:0; position:relative; }
  .sidebar{
    width:264px; flex-shrink:0; background:var(--surface);
    border-right:1px solid var(--line); display:flex; flex-direction:column; min-height:0;
  }
  .canvas-wrap{ flex:1; position:relative; min-width:0; background:var(--canvas-bg); overflow:hidden; }
  #canvas{ position:absolute; inset:0; width:100%; height:100%; display:block; cursor:default; }
  .inspector{
    width:312px; flex-shrink:0; background:var(--surface);
    border-left:1px solid var(--line); overflow-y:auto; min-height:0;
  }

  /* ============ SIDEBAR ============ */
  .side-head{ padding:14px 16px 10px; display:flex; align-items:center; justify-content:space-between; }
  .side-head h4{ font-family:'Space Grotesk'; font-size:13px; font-weight:600; letter-spacing:.01em; }
  .side-count{ font-family:'IBM Plex Mono',monospace; font-size:10px; color:var(--ink-faint); }
  .side-actions{ display:flex; gap:6px; padding:0 16px 12px; }
  .mini-btn{
    flex:1; display:inline-flex; align-items:center; justify-content:center; gap:6px;
    height:32px; border-radius:9px; border:1px solid var(--line); background:var(--surface);
    font-size:12px; font-weight:600; color:var(--ink-soft); cursor:pointer; transition:all .15s;
  }
  .mini-btn:hover{ color:var(--ink); border-color:var(--ink-faint); }
  .mini-btn svg{ width:13px; height:13px; }
  .side-filter{ padding:0 16px 12px; display:flex; flex-direction:column; gap:8px; }
  .side-filter input{ width:100%; }
  .side-filter .f-row{ display:flex; gap:6px; }
  .side-filter select{ flex:1; font-size:12px; padding:7px 8px; }

  .map-list{ flex:1; overflow-y:auto; padding:0 10px 14px; display:flex; flex-direction:column; gap:8px; }
  .map-card{
    border:1px solid var(--line); border-radius:12px; padding:11px 12px;
    cursor:pointer; transition:all .18s var(--ease); position:relative; background:var(--surface);
  }
  .map-card:hover{ border-color:var(--ink-faint); }
  .map-card.active{ border-color:var(--blue); background:color-mix(in srgb,var(--blue) 6%,var(--surface)); }
  .map-card .m-name{ font-weight:600; font-size:13px; display:flex; align-items:center; gap:8px; }
  .map-card .m-name input{ font-size:12px; padding:4px 6px; flex:1; min-width:0; }
  .map-card .m-meta{ font-family:'IBM Plex Mono',monospace; font-size:10px; color:var(--ink-faint); margin-top:5px; display:flex; gap:10px; align-items:center; }
  .map-card .m-actions{ position:absolute; top:8px; right:8px; display:none; gap:3px; }
  .map-card:hover .m-actions{ display:flex; }
  .m-act{
    width:24px; height:24px; border-radius:7px; border:1px solid var(--line); background:var(--surface);
    display:grid; place-items:center; cursor:pointer; color:var(--ink-soft); transition:all .15s;
  }
  .m-act:hover{ color:var(--ink); border-color:var(--ink-faint); }
  .m-act.danger:hover{ color:var(--red); border-color:var(--red); }
  .m-act svg{ width:12px; height:12px; }
  .side-hint{ padding:12px 16px; border-top:1px solid var(--line); font-size:11px; color:var(--ink-faint); line-height:1.6; }
  .side-hint b{ color:var(--ink-soft); font-weight:600; }
  .theme-row{ display:flex; align-items:center; gap:8px; padding:12px 16px; border-top:1px solid var(--line); }
  .theme-row span{ font-size:12.5px; font-weight:600; color:var(--ink-soft); }
  .switch{ position:relative; width:38px; height:22px; border-radius:20px; background:var(--line); cursor:pointer; transition:background .2s; margin-left:auto; flex-shrink:0; }
  .switch.on{ background:var(--grad); }
  .switch::after{ content:''; position:absolute; top:2px; left:2px; width:18px; height:18px; border-radius:50%; background:#fff; transition:transform .25s var(--ease); box-shadow:0 1px 4px rgba(0,0,0,.3); }
  .switch.on::after{ transform:translateX(16px); }

  /* ============ STATUS BAR ============ */
  .statusbar{
    display:flex; align-items:center; gap:18px; padding:5px 16px;
    background:var(--surface); border-top:1px solid var(--line);
    font-family:'IBM Plex Mono',monospace; font-size:10.5px; color:var(--ink-faint); flex-shrink:0;
  }
  .statusbar .sb-right{ margin-left:auto; display:flex; align-items:center; gap:14px; }
  .statusbar .save-state{ display:inline-flex; align-items:center; gap:6px; }
  .statusbar .save-state::before{ content:''; width:6px; height:6px; border-radius:50%; background:var(--green); }
  .statusbar .save-state.saving::before{ background:var(--amber); animation:pulse 1s infinite; }
  @keyframes pulse{ 50%{ opacity:.3; } }
  .zoom-btn{
    width:24px; height:24px; border-radius:7px; border:1px solid var(--line); background:var(--surface);
    color:var(--ink-soft); cursor:pointer; display:grid; place-items:center; font-size:14px; transition:all .15s;
  }
  .zoom-btn:hover{ color:var(--ink); border-color:var(--ink-faint); }
  .zoom-btn svg{ width:12px; height:12px; }

  /* ============ INSPECTOR ============ */
  .insp-head{
    padding:14px 16px; border-bottom:1px solid var(--line);
    display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; background:var(--surface); z-index:2;
  }
  .insp-head h4{ font-family:'Space Grotesk'; font-size:13px; font-weight:600; }
  .insp-close{ border:none; background:none; color:var(--ink-faint); cursor:pointer; font-size:16px; padding:4px; border-radius:6px; }
  .insp-close:hover{ color:var(--ink); background:var(--bg-alt); }
  .insp-body{ padding:16px; display:flex; flex-direction:column; gap:16px; }
  .fld label{ display:block; font-family:'IBM Plex Mono',monospace; font-size:10px; letter-spacing:.1em; text-transform:uppercase; color:var(--ink-faint); margin-bottom:6px; }
  .fld input[type=text], .fld textarea, .fld select{ width:100%; }
  .fld textarea{ resize:vertical; min-height:64px; line-height:1.5; }
  .fld .hint{ font-size:11px; color:var(--ink-faint); margin-top:5px; line-height:1.5; }
  .chip-row{ display:flex; flex-wrap:wrap; gap:6px; margin-top:8px; }
  .chip{
    display:inline-flex; align-items:center; gap:5px;
    background:color-mix(in srgb,var(--blue) 10%,var(--surface));
    color:var(--blue); border:1px solid color-mix(in srgb,var(--blue) 25%,transparent);
    font-size:11px; font-weight:600; padding:3px 9px; border-radius:20px;
  }
  .chip button{ border:none; background:none; color:inherit; cursor:pointer; font-size:12px; line-height:1; opacity:.7; padding:0; }
  .chip button:hover{ opacity:1; }
  .seg{ display:flex; gap:5px; flex-wrap:wrap; }
  .seg .opt{
    flex:1; padding:7px 8px; border-radius:8px; border:1px solid var(--line);
    font-size:11.5px; font-weight:600; color:var(--ink-soft); cursor:pointer; text-align:center; transition:all .15s; min-width:44px;
  }
  .seg .opt.sel{ color:#fff; border-color:transparent; }
  .seg .opt:hover:not(.sel){ border-color:var(--ink-faint); color:var(--ink); }
  .insp-swatch-row{ display:flex; flex-wrap:wrap; gap:8px; }
  .insp-swatch{ width:26px; height:26px; border-radius:8px; cursor:pointer; border:2px solid transparent; transition:transform .15s; }
  .insp-swatch:hover{ transform:scale(1.15); }
  .insp-swatch.sel{ border-color:var(--ink); }
  .insp-swatch.reset{ background:conic-gradient(#EF4444,#F59E0B,#84CC16,#06B6D4,#4F6FEF,#8B5CF6,#EF4444); }
  .insp-actions{ display:flex; gap:8px; }
  .insp-actions .btn{
    flex:1; display:inline-flex; align-items:center; justify-content:center; gap:7px;
    height:36px; border-radius:10px; font-size:12.5px; font-weight:600; cursor:pointer;
    border:1px solid var(--line); background:var(--surface); color:var(--ink-soft); transition:all .15s;
  }
  .insp-actions .btn:hover{ color:var(--ink); border-color:var(--ink-faint); }
  .insp-actions .btn.danger{ color:var(--red); }
  .insp-actions .btn.danger:hover{ background:color-mix(in srgb,var(--red) 8%,var(--surface)); border-color:var(--red); }
  .insp-actions .btn.primary{ background:var(--grad); color:#fff; border-color:transparent; }
  .stat-grid{ display:grid; grid-template-columns:1fr 1fr; gap:8px; }
  .stat{
    background:var(--bg-alt); border:1px solid var(--line); border-radius:10px; padding:10px 12px;
  }
  .stat b{ display:block; font-family:'Space Grotesk'; font-size:17px; }
  .stat span{ font-size:10.5px; color:var(--ink-faint); text-transform:uppercase; letter-spacing:.06em; font-family:'IBM Plex Mono',monospace; }
  .empty-insp{ padding:26px 20px; text-align:center; color:var(--ink-faint); font-size:13px; line-height:1.7; }

  /* ============ OVERLAYS ============ */
  #titleEditor{
    position:absolute; z-index:30; display:none;
    background:var(--surface); color:var(--ink);
    border:2px solid var(--blue); border-radius:8px;
    padding:6px 8px; font-family:'Inter',sans-serif; font-weight:600; font-size:14px;
    outline:none; resize:none; box-shadow:0 8px 30px -8px rgba(79,111,239,.5); line-height:1.35;
  }
  #tooltip{
    position:fixed; z-index:80; display:none; pointer-events:none;
    background:var(--surface); border:1px solid var(--line); border-radius:12px;
    box-shadow:var(--shadow); padding:12px 14px; max-width:280px;
    font-size:12px; color:var(--ink-soft); line-height:1.55;
  }
  #tooltip .tt-title{ font-weight:700; font-size:13px; color:var(--ink); margin-bottom:4px; display:flex; align-items:center; gap:7px; }
  #tooltip .tt-title .tt-ic{ width:20px; height:20px; border-radius:6px; display:grid; place-items:center; font-size:11px; color:#fff; flex-shrink:0; }
  #tooltip .tt-tags{ display:flex; flex-wrap:wrap; gap:4px; margin-top:7px; }
  #tooltip .tt-tag{ font-size:10px; font-weight:600; background:var(--bg-alt); border:1px solid var(--line); border-radius:10px; padding:2px 7px; color:var(--ink-soft); }
  #tooltip .tt-meta{ display:flex; gap:6px; margin-top:7px; flex-wrap:wrap; }
  #tooltip .tt-pill{ font-size:9.5px; font-weight:700; border-radius:8px; padding:2px 7px; color:#fff; font-family:'IBM Plex Mono',monospace; }
  .empty-state{
    position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14px;
    pointer-events:none; color:var(--ink-faint); text-align:center; z-index:5;
  }
  .empty-state .big{ font-size:40px; }
  .empty-state p{ font-size:14px; max-width:340px; line-height:1.6; }
  .empty-state kbd{
    font-family:'IBM Plex Mono',monospace; font-size:11px; background:var(--bg-alt);
    border:1px solid var(--line); border-bottom-width:2px; border-radius:6px; padding:2px 7px; color:var(--ink-soft);
  }
  .toast{
    position:fixed; bottom:46px; left:50%; transform:translateX(-50%) translateY(20px);
    background:var(--ink); color:var(--bg); padding:10px 20px; border-radius:12px;
    font-size:13px; font-weight:600; z-index:200; opacity:0; pointer-events:none;
    transition:all .3s var(--ease); box-shadow:0 12px 30px -8px rgba(0,0,0,.4);
  }
  .toast.show{ opacity:1; transform:translateX(-50%) translateY(0); }

  /* help modal */
  .modal-mask{
    position:fixed; inset:0; background:rgba(5,7,13,.55); backdrop-filter:blur(4px);
    z-index:150; display:none; align-items:center; justify-content:center; padding:20px;
  }
  .modal-mask.open{ display:flex; }
  .modal{
    background:var(--surface); border:1px solid var(--line); border-radius:18px;
    width:100%; max-width:640px; max-height:85vh; overflow-y:auto; box-shadow:var(--shadow);
    animation: popIn .2s var(--ease);
  }
  .modal-head{ padding:20px 24px 14px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--line); }
  .modal-head h3{ font-family:'Space Grotesk'; font-size:17px; }
  .modal-body{ padding:20px 24px; }
  .modal-body h5{ font-family:'IBM Plex Mono',monospace; font-size:10.5px; letter-spacing:.12em; text-transform:uppercase; color:var(--ink-faint); margin:18px 0 10px; }
  .modal-body h5:first-child{ margin-top:0; }
  .kbd-grid{ display:grid; grid-template-columns:1fr 1fr; gap:8px 22px; }
