  var html = '<div class="tt-title"><span class="tt-ic" style="background:' + (n.color||t.color) + '">' + t.icon + '</span>' + esc(n.title||'Nodo') + '</div>';
  if (n.description) html += '<div>' + esc(n.description) + '</div>';
  var meta = '<div class="tt-meta">';
  meta += '<span class="tt-pill" style="background:' + imp.color + '">' + imp.label.toUpperCase() + '</span>';
  if (n.priority && PRIORITIES[n.priority]) meta += '<span class="tt-pill" style="background:' + PRIORITIES[n.priority].color + '">' + PRIORITIES[n.priority].label + '</span>';
  meta += '<span class="tt-pill" style="background:' + (n.color||t.color) + '">' + t.name.toUpperCase() + '</span>';
  meta += '</div>';
  if (n.tags && n.tags.length){
    html += '<div class="tt-tags">' + n.tags.map(function(tg){ return '<span class="tt-tag">' + esc(tg) + '</span>'; }).join('') + '</div>';
  }
  html += meta;
