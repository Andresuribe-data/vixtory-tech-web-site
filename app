  var x = state.lastP.x + 16, y = state.lastP.y + 18;
  if (x + tw > window.innerWidth - 8) x = state.lastP.x - tw - 12;
  if (y + th > window.innerHeight - 8) y = state.lastP.y - th - 10;
  tooltip.style.left = Math.max(8, x) + 'px';
  tooltip.style.top = Math.max(8, y) + 'px';
}
function hideTooltip(){ clearTimeout(ttTimer); tooltip.style.display = 'none'; state.hoverNode = null; }

/* ---------------- Interacción con puntero ---------------- */
function canvasPos(e){
  var r = canvas.getBoundingClientRect();
  return { x: e.clientX - r.left, y: e.clientY - r.top };
}
function worldAt(e){
  var p = canvasPos(e);
  return { wx: sx2wx(p.x), wy: sy2wy(p.y), x: p.x, y: p.y };
}
function hitTest(wx, wy, skip){
  var m = currentMap();
  if (!m) return null;
  for (var i=m.nodes.length-1;i>=0;i--){
    var n = m.nodes[i];
    if (n.id === skip) continue;
    if (nodeHit(n, wx, wy)) return n;
  }
  return null;
}
function portAt(wx, wy, n){
  var m = measureNode(n);
  var hw = m.w/2, hh = m.h/2;
  var ports = [ ['n', 0, -hh], ['s', 0, hh], ['e', hw, 0], ['w', -hw, 0] ];
  for (var i=0;i<ports.length;i++){
    var p = ports[i];
    var dx = wx - (n.x + p[1]), dy = wy - (n.y + p[2]);
    if (Math.abs(dx) <= 7 && Math.abs(dy) <= 7) return p[0];
  }
  return null;
}

canvas.addEventListener('pointerdown', function(e){
  if (state.editing){ commitTitleEdit(); return; }
  var m = currentMap();
  if (!m) return;
  canvas.setPointerCapture(e.pointerId);
  var w = worldAt(e);
  var n = e.button === 0 ? hitTest(w.wx, w.wy) : null;

  // botón derecho o medio → pan
  if (e.button === 1 || e.button === 2 || state.hand){
    state.pointer = { kind:'pan', x:e.clientX, y:e.clientY, startX:state.view.x, startY:state.view.y };
    canvas.style.cursor = 'grabbing';
    return;
  }
  // espacio → pan
  if (e.button === 0 && (e.shiftKey || spaceDown)){
    state.pointer = { kind:'pan', x:e.clientX, y:e.clientY, startX:state.view.x, startY:state.view.y };
    canvas.style.cursor = 'grabbing';
    return;
  }

  if (n){
    // asa de redimensionado (esquina inferior derecha del nodo seleccionado)
    if (e.button === 0 && state.selection.nodes.length === 1 && state.selection.nodes[0] === n.id){
      var ms0 = measureNode(n);
      var thr0 = 12 / state.view.zoom;
      if (Math.abs(w.wx - (n.x + ms0.w/2)) <= thr0 && Math.abs(w.wy - (n.y + ms0.h/2)) <= thr0){
        var c0 = Math.hypot(w.wx - n.x, w.wy - n.y);
        state.pointer = { kind:'resize', id: n.id, c0: Math.max(c0, 1), s0: n.scale || 1 };
        canvas.style.cursor = 'nwse-resize';
        return;
      }
    }
    // puerto?
    var prt = portAt(w.wx, w.wy, n);
    if (prt || state.connectMode){
      state.linkDrag = { from: n.id, cx: w.x, cy: w.y };
      state.pointer = { kind:'link', x:e.clientX, y:e.clientY };
      canvas.style.cursor = 'crosshair';
      return;
    }
    // seleccionar
    if (e.shiftKey){
      var i = state.selection.nodes.indexOf(n.id);
      if (i >= 0) state.selection.nodes.splice(i,1);
      else state.selection.nodes.push(n.id);
      state.selection.edges = [];
    } else {
      if (state.selection.nodes.indexOf(n.id) === -1){
        state.selection.nodes = [n.id];
        state.selection.edges = [];
      }
    }
    renderInspector();
    // mover
    var startPos = {};
    state.selection.nodes.forEach(function(id){
      var nn = nodeById(id);
      if (nn) startPos[id] = { x: nn.x, y: nn.y };
    });
    state.pointer = { kind:'move', x:e.clientX, y:e.clientY, startPos:startPos, moved:false };
    canvas.style.cursor = 'grabbing';
    state.dirty = true; requestRender();
    return;
  }

  // clic en arista
  var hitEdge = null, best = 12 / state.view.zoom;
  m.edges.forEach(function(ed){
    var d = edgeDist(w.wx, w.wy, ed);
    if (d < best){ best = d; hitEdge = ed; }
  });
  if (hitEdge){
    state.selection.nodes = [];
    state.selection.edges = [hitEdge.id];
    renderInspector(); requestRender();
    return;
  }

  // vacío → deseleccionar + marquee
  state.selection.nodes = [];
  state.selection.edges = [];
  renderInspector();
  state.marquee = { x0: w.x, y0: w.y, x: w.x, y: w.y, w: 0, h: 0 };
  state.pointer = { kind:'marquee', x:e.clientX, y:e.clientY };
  requestRender();
});

var spaceDown = false;
canvas.addEventListener('pointermove', function(e){
  var w = worldAt(e);
  state.animT = performance.now();
  state.lastP = { x: e.clientX, y: e.clientY };

  if (state.pointer){
    var p = state.pointer;
    if (p.kind === 'pan'){
      state.view.x = p.startX - (e.clientX - p.x)/state.view.zoom;
      state.view.y = p.startY - (e.clientY - p.y)/state.view.zoom;
      positionTitleEditor();
      state.dirty = true; requestRender();
      return;
    }
    if (p.kind === 'link' && state.linkDrag){
      state.linkDrag.cx = w.x; state.linkDrag.cy = w.y;
      state.dirty = true; requestRender();
      return;
    }
    if (p.kind === 'move'){
      var dx = (e.clientX - p.x)/state.view.zoom;
      var dy = (e.clientY - p.y)/state.view.zoom;
      if (Math.abs(e.clientX-p.x) + Math.abs(e.clientY-p.y) > 3) p.moved = true;
      state.selection.nodes.forEach(function(id){
        var nn = nodeById(id);
        if (nn && p.startPos[id]){ nn.x = p.startPos[id].x + dx; nn.y = p.startPos[id].y + dy; }
      });
      state.dirty = true; requestRender();
      return;
    }
    if (p.kind === 'resize'){
      var rn = nodeById(p.id);
      if (rn){
        var cd = Math.hypot(w.wx - rn.x, w.wy - rn.y);
        var s = clamp(p.s0 * (cd / p.c0), 0.5, 2.5);
        rn.scale = Math.round(s * 100) / 100;
        rn.updated = Date.now();
      }
      state.dirty = true; requestRender();
      return;
    }
    if (p.kind === 'marquee'){
      var mx0 = Math.min(p.x, w.x), my0 = Math.min(p.y, w.y);
      state.marquee = { x0: p.x, y0: p.y, x: mx0, y: my0, w: Math.abs(w.x-p.x), h: Math.abs(w.y-p.y) };
      state.dirty = true; requestRender();
      return;
    }
  }

  // hover
  var n = hitTest(w.wx, w.wy);
  var hoverChanged = state.hoverNode !== (n ? n.id : null);
  state.hoverNode = n ? n.id : null;
  if (n && n !== state.hoveredNodeObj){
    state.hoveredNodeObj = n;
    clearTimeout(ttTimer);
    ttTimer = setTimeout(function(){ if (state.hoverNode === n.id && !state.pointer) showTooltip(n); }, 450);
  } else if (!n){
    state.hoveredNodeObj = null;
    hideTooltip();
  }
  if (hoverChanged){
    var cur = n ? (state.connectMode ? 'crosshair' : 'move') : 'default';
    if (n && state.selection.nodes.length === 1 && state.selection.nodes[0] === n.id){
      var mh = measureNode(n);
      var thrh = 12 / state.view.zoom;
      if (Math.abs(w.wx - (n.x + mh.w/2)) <= thrh && Math.abs(w.wy - (n.y + mh.h/2)) <= thrh){
        cur = 'nwse-resize';
      }
    }
    canvas.style.cursor = cur;
    state.dirty = true; requestRender();
  }
});

canvas.addEventListener('pointerup', function(e){
  var p = state.pointer;
  if (!p) return;
  var w = worldAt(e);

  if (p.kind === 'move' && p.moved){
    pushHistory();
    markChanged();
  }
  if (p.kind === 'resize'){
    pushHistory();
    markChanged();
  }
  if (p.kind === 'link' && state.linkDrag){
    var target = hitTest(w.wx, w.wy, state.linkDrag.from);
    if (target){
      var eid = addEdge(state.linkDrag.from, target.id);
      if (eid){
        state.selection.nodes = [];
        state.selection.edges = [eid];
        renderInspector();
      }
    }
    state.linkDrag = null;
    state.connectMode = false;
    syncToolButtons();
  }
  if (p.kind === 'marquee'){
    var m = currentMap();
    if (m && state.marquee && (state.marquee.w > 4 || state.marquee.h > 4)){
      var x0 = Math.min(state.marquee.x0, w.x), x1 = Math.max(state.marquee.x0, w.x);
      var y0 = Math.min(state.marquee.y0, w.y), y1 = Math.max(state.marquee.y0, w.y);
      state.selection.nodes = m.nodes.filter(function(n){
        var r = nodeRect(n);
        return r.x < x1 && r.x + r.w > x0 && r.y < y1 && r.y + r.h > y0;
      }).map(function(n){ return n.id; });
      state.selection.edges = [];
      renderInspector();
    }
    state.marquee = null;
  }
  state.pointer = null;
  canvas.style.cursor = 'default';
  state.dirty = true; requestRender();
});

canvas.addEventListener('pointercancel', function(){ state.pointer = null; state.marquee = null; state.linkDrag = null; requestRender(); });
canvas.addEventListener('contextmenu', function(e){ e.preventDefault(); });

canvas.addEventListener('dblclick', function(e){
  if (state.editing){ commitTitleEdit(); return; }
  var w = worldAt(e);
  var n = hitTest(w.wx, w.wy);
  if (n){
    startTitleEdit(n.id);
  } else {
    var node = createNode(state.tool.type, w.wx, w.wy);
    pushHistory();
    state.selection.nodes = [node.id];
    state.selection.edges = [];
    markChanged(); renderInspector(); requestRender();
    startTitleEdit(node.id);
  }
});

/* zoom con rueda */
canvas.addEventListener('wheel', function(e){
  e.preventDefault();
  var w = worldAt(e);
  var factor = Math.exp(-e.deltaY * 0.0012);
  setZoom(state.view.zoom * factor, w.wx, w.wy);
}, { passive:false });

function setZoom(nz, wx, wy){
  nz = clamp(nz, 0.15, 3);
  if (nz === state.view.zoom) return;
  if (wx === undefined){ wx = sx2wx(VIEW_W/2); wy = sy2wy(VIEW_H/2); }
  // mantener el punto del mundo bajo el cursor
  state.view.x = wx - (VIEW_W/2)/nz;
  state.view.y = wy - (VIEW_H/2)/nz;
  state.view.zoom = nz;
  positionTitleEditor();
  buildGridCache();
  updateZoomLabel();
  state.dirty = true; requestRender();
}
function updateZoomLabel(){ $('zoomLabel').textContent = Math.round(state.view.zoom*100) + '%'; }
$('zoomIn').addEventListener('click', function(){ setZoom(state.view.zoom*1.25); });
$('zoomOut').addEventListener('click', function(){ setZoom(state.view.zoom/1.25); });

function fitView(){
  var m = currentMap();
  if (!m || !m.nodes.length){ setZoom(1, 0, 0); return; }
  var minX=1e9, minY=1e9, maxX=-1e9, maxY=-1e9;
  m.nodes.forEach(function(n){
    var r = nodeRect(n);
    minX = Math.min(minX, r.x); minY = Math.min(minY, r.y);
    maxX = Math.max(maxX, r.x+r.w); maxY = Math.max(maxY, r.y+r.h);
  });
  var bw = maxX-minX, bh = maxY-minY;
  var pad = 90;
  var z = clamp(Math.min((VIEW_W-60)/Math.max(bw,10), (VIEW_H-60)/Math.max(bh,10)), 0.15, 1.6);
  state.view.zoom = z;
  state.view.x = (minX+maxX)/2 - (VIEW_W/2)/z;
  state.view.y = (minY+maxY)/2 - (VIEW_H/2)/z;
  buildGridCache(); updateZoomLabel(); state.dirty = true; requestRender();
}
$('btnFit').addEventListener('click', fitView);

/* ---------------- Teclado ---------------- */
document.addEventListener('keydown', function(e){
  if (state.editing){
    if (e.key === 'Escape'){ state.editing=null; titleEditor.style.display='none'; }
    return;
  }
  var mod = e.ctrlKey || e.metaKey;
  if (mod && e.key.toLowerCase() === 'z' && !e.shiftKey){ e.preventDefault(); undo(); return; }
  if ((mod && e.key.toLowerCase() === 'y') || (mod && e.shiftKey && e.key.toLowerCase()==='z')){ e.preventDefault(); redo(); return; }
  if (mod && e.key.toLowerCase() === 'd'){ e.preventDefault(); duplicateSelection(); return; }
  if (mod && e.key.toLowerCase() === 'a'){ e.preventDefault(); selectAll(); return; }
  if (mod && e.key.toLowerCase() === 's'){ e.preventDefault(); saveAll(); toast('Mapa guardado'); return; }
  if (mod && e.key.toLowerCase() === 'n'){ e.preventDefault(); createNodeAtCenter(); return; }
  if (e.key === 'Delete' || e.key === 'Backspace'){
    var tag = e.target.tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA') return;
    e.preventDefault(); deleteSelection(); return;
  }
  if (e.key === 'Escape'){
    state.selection.nodes = []; state.selection.edges = [];
    renderInspector(); requestRender(); return;
  }
  if (e.key === 'Enter' || e.key === 'F2'){
    if (state.selection.nodes.length === 1){ e.preventDefault(); startTitleEdit(state.selection.nodes[0]); }
    return;
  }
  if (e.key === ' '){
    spaceDown = true;
    canvas.style.cursor = 'grab';
    return;
  }
  if (e.key.toLowerCase() === 'c'){ toggleConnect(); return; }
  if (e.key.toLowerCase() === 'h'){ toggleHand(); return; }
  if (e.key.toLowerCase() === 'f'){ fitView(); return; }
  if (e.key === '+' || e.key === '='){ setZoom(state.view.zoom*1.2); return; }
  if (e.key === '-'){ setZoom(state.view.zoom/1.2); return; }
});
function createNodeAtCenter(){
  var vx = state.view.x + VIEW_W/2/state.view.zoom;
  var vy = state.view.y + VIEW_H/2/state.view.zoom;
  var nn = createNode(state.tool.type, vx, vy);
  pushHistory();
  state.selection.nodes = [nn.id]; state.selection.edges = [];
  markChanged(); renderInspector(); requestRender();
  startTitleEdit(nn.id);
}
document.addEventListener('keyup', function(e){
  if (e.key === ' '){ spaceDown = false; canvas.style.cursor = 'default'; }
});
function selectAll(){
  var m = currentMap();
  if (!m) return;
  state.selection.nodes = m.nodes.map(function(n){ return n.id; });
  state.selection.edges = [];
  renderInspector(); requestRender();
}

